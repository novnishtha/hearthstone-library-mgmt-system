{
  "info": {
    "name": "Library Management System API",
    "_postman_id": "a7e5c2b0-9c44-4d1a-9f31-100000000001",
    "description": "Complete REST API collection for the Library Management System (Auth, Books, Borrowers, and Transactional Issue/Return).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"email\": \"asha.postman@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha.postman@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('bookId', pm.response.json().data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"978-0132350884\",\n  \"category\": \"Software Engineering\",\n  \"publishedYear\": 2008,\n  \"totalCopies\": 3,\n  \"description\": \"A handbook of agile software craftsmanship.\"\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "List / Search Books",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?q=Clean&available=true"
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 4,\n  \"description\": \"Updated edition.\"\n}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "Borrowers",
      "item": [
        {
          "name": "Register Borrower",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('borrowerId', pm.response.json().data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Mehta\",\n  \"email\": \"rohan.postman@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"42 MG Road, Bengaluru\"\n}"
            },
            "url": "{{baseUrl}}/borrowers"
          }
        },
        {
          "name": "List / Search Borrowers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/borrowers?q=Rohan&status=active"
          }
        },
        {
          "name": "Get Borrower By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/borrowers/{{borrowerId}}"
          }
        },
        {
          "name": "Update Borrower",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876500000\"\n}"
            },
            "url": "{{baseUrl}}/borrowers/{{borrowerId}}"
          }
        },
        {
          "name": "Toggle Borrower Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/borrowers/{{borrowerId}}/status"
          }
        },
        {
          "name": "Get Borrower Issue History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/borrowers/{{borrowerId}}/history"
          }
        },
        {
          "name": "Delete Borrower",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/borrowers/{{borrowerId}}"
          }
        }
      ]
    },
    {
      "name": "Issue & Return",
      "item": [
        {
          "name": "Issue Book (Transaction)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('issueId', pm.response.json().data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"borrowerId\": \"{{borrowerId}}\",\n  \"notes\": \"Good condition\"\n}"
            },
            "url": "{{baseUrl}}/issues"
          }
        },
        {
          "name": "List Issue Records",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/issues?status=issued"
          }
        },
        {
          "name": "Get Issue Record By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/issues/{{issueId}}"
          }
        },
        {
          "name": "Return Book (Transaction)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Marked returned', () => pm.expect(pm.response.json().data.status).to.eql('returned'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/issues/{{issueId}}/return"
          }
        }
      ]
    }
  ]
}
